{
  "name": "incident-context",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "server": "tsx src/server/index.ts",
    "test": "tsx --test src/server/*.test.ts src/worker/*.test.ts evaluation/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "evaluate": "tsx evaluation/run.ts",
    "evaluate:live": "tsx evaluation/live.ts",
    "deploy": "npm run build && wrangler deploy",
    "cf:types": "wrangler types worker-env.d.ts"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}
