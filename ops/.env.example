# Absolute Linux paths; keep the actual ops/.env ignored.
# Set UID and GID to the owner of the bind-mounted data and dependency files.
HYDRA_UID=1000
HYDRA_GID=1000
HYDRA_DATA_DIR=/data/workspace/hydradb/data/engine
API_DATA_DIR=/data/workspace/hydradb/data/api
BACKEND_TOKEN_FILE=/data/workspace/hydradb/data/backend-token
APP_SOURCE_DIR=/data/workspace/hydradb/incident-context
